# Hotfix on top of the deployed mobile11 image.
# The base already contains all mobile/OIDC patches; this image only fixes
# the invalid MediaSoup spatial-layer request for single-encoding producers.
FROM ghcr.io/rgaliull/mirotalk-sfu-public@sha256:28842ac553d56e6580fb074a38ae08e27a344baa574adcbc5a83fc0e88fd1ebc

RUN node - <<'NODE'
const fs = require('fs');
const filename = '/src/app/src/Peer.js';
let source = fs.readFileSync(filename, 'utf8');
const before = `            const spatialLayer = this.peer_info?.is_mobile_device
                ? 1
                : parseInt(scalabilityMode.substring(1, 2)); // 1/2/3
            const temporalLayer = this.peer_info?.is_mobile_device
                ? 1
                : parseInt(scalabilityMode.substring(3, 4)); // 1/2/3`;
const after = `            const spatialLayer = this.peer_info?.is_mobile_device
                ? rtpParameters.encodings.length > 1
                    ? 1
                    : 0
                : Math.max(0, Math.min(parseInt(scalabilityMode.substring(1, 2)) - 1, rtpParameters.encodings.length - 1));
            const temporalLayer = Math.max(0, parseInt(scalabilityMode.substring(3, 4)) - 2);`;
if (!source.includes(before)) throw new Error('Expected mobile11 consumer layer block not found');
source = source.replace(before, after);
fs.writeFileSync(filename, source);
NODE
